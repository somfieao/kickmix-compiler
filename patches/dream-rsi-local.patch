diff --git a/dream_rsi/exploration/history_seed.py b/dream_rsi/exploration/history_seed.py
index ea4af01..8f87a09 100644
--- a/dream_rsi/exploration/history_seed.py
+++ b/dream_rsi/exploration/history_seed.py
@@ -34,10 +34,43 @@ def list_workspace_archives(workspace: Path) -> list[Path]:
 
 
 def _seed_mode() -> str:
-    """``copy`` (default, as in the paper runs) or ``symlink`` to save disk space."""
+    """``copy`` (default, as in the paper runs), ``symlink`` to save disk space,
+    or ``pruned``: agents see only proposals and scores of earlier rounds.
+
+    ``pruned`` seeds each attempt's ``proposal.md``, ``eval/score.json``,
+    ``error.txt`` and ``meta.json`` (plus the round's ``raw_scores.json``), and
+    strips program artifacts, ``agent_log/`` and everything else, so exploration
+    agents cannot read earlier attempts' code — only what they claimed and how
+    it measured. This matches the visibility protocol of the paper's Listing 1
+    while enforcing it structurally."""
     return os.environ.get("DRSI_HISTORY_SEED_MODE", "copy").strip().lower()
 
 
+_PRUNED_ATTEMPT_FILES = ("proposal.md", "meta.json", "error.txt")
+_PRUNED_ARCHIVE_FILES = ("raw_scores.json",)
+
+
+def _pruned_copy(archive: Path, dst: Path) -> None:
+    """Copy `archive` to `dst` keeping only proposals/scores (see _seed_mode)."""
+    dst.mkdir(parents=True, exist_ok=True)
+    for name in _PRUNED_ARCHIVE_FILES:
+        src = archive / name
+        if src.is_file():
+            shutil.copy2(src, dst / name)
+    for attempt in sorted(archive.glob("explore_b*/attempt_*")):
+        rel = attempt.relative_to(archive)
+        out = dst / rel
+        out.mkdir(parents=True, exist_ok=True)
+        for name in _PRUNED_ATTEMPT_FILES:
+            src = attempt / name
+            if src.is_file():
+                shutil.copy2(src, out / name)
+        src_score = attempt / "eval" / "score.json"
+        if src_score.is_file():
+            (out / "eval").mkdir(exist_ok=True)
+            shutil.copy2(src_score, out / "eval" / "score.json")
+
+
 def seed_history_to_branches(
     workspace: Path,
     *,
@@ -69,7 +102,9 @@ def seed_history_to_branches(
             dst = dst_root / arch.name
             if dst.exists() or dst.is_symlink():
                 continue
-            if use_symlink:
+            if mode == "pruned":
+                _pruned_copy(arch, dst)
+            elif use_symlink:
                 dst.symlink_to(arch.resolve(), target_is_directory=True)
             else:
                 shutil.copytree(arch, dst, dirs_exist_ok=True, symlinks=True)
