# kickmix-compiler run configuration.
# Copy to `.env` (chmod 600) and fill in your own credentials. Never commit it.
# .env is sourced by scripts/*.sh from the repo root, so relative $PWD below is
# the repo root.

# --- Agent model: DeepSeek through the Anthropic-compatible endpoint ---------
# claude-agent-sdk drives the Claude Code CLI; these variables point it at DeepSeek.
export ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
export ANTHROPIC_AUTH_TOKEN="sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY"
export ANTHROPIC_MODEL="deepseek-flash"            # DeepSeek-V4.1-Flash
export ANTHROPIC_SMALL_FAST_MODEL="deepseek-flash"
# dream-rsi passes these explicitly to ClaudeAgentOptions (see the local patch).
export DRSI_CLAUDE_MODEL="deepseek-flash"
export DRSI_CLAUDE_EFFORT="low"                    # low | high | max
export CLAUDE_EXEC_TIMEOUT_SEC="5400"              # per-attempt hard cap (s)

# --- Isolation (do not disable for shared/competition runs) ------------------
export DRSI_SANDBOX="1"                            # bwrap sandbox per agent
export DRSI_HISTORY_SEED_MODE="pruned"             # proposals+scores only across rounds

# --- Evaluation --------------------------------------------------------------
export DRSI_EVAL_PROGRAM="artifact/program.py"     # agent writes this per attempt
export DRSI_EVAL_PYTHON="$PWD/.venv/bin/python-km" # venv python + bundled libstdc++
export DRSI_EVAL_TIMEOUT_SEC="3000"                # whole evaluate() budget
export VQCC_VERIFY_WORKERS="8"                     # verifier CPU workers per eval
export DRSI_AGENT_STREAM="1"                       # live agent log on stdout
