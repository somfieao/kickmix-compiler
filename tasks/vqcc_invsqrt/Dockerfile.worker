# Task worker image: modern glibc + C++20 compiler + kickmix + verifier.
# Build context = repository root:
#   docker build -f tasks/vqcc_invsqrt/Dockerfile.worker -t kickmix-vqcc-invsqrt:<tag> .
FROM ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip g++ make ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir numpy "pybind11==2.12.0" setuptools wheel

COPY upstream/kickmix /src/kickmix
RUN cd /src/kickmix && /opt/venv/bin/pip install --no-cache-dir --no-build-isolation .

COPY data/verifiers/invsqrt /verifier/invsqrt

ENTRYPOINT ["/opt/venv/bin/python"]
