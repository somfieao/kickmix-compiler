# Claude CLI agent settings for vqcc_invsqrt under the DREAM-RSI paper protocol.
# Run sizes (rounds, grid, workers, learning) are the upstream launch-script
# defaults; set ROUNDS, BRANCHES, REFINE, MAX_WORKERS etc. only to deviate.
export AGENT=claude
export DRSI_CLAUDE_CLI="${DRSI_CLAUDE_CLI:-$(command -v claude || true)}"
# Learning agents get the upstream shell interface; exploration agents get the
# paper's file-tools-only contract (backend_settings.py narrows them further).
export DRSI_CLAUDE_PERMISSION_MODE=bypassPermissions
export ENABLE_TOOL_SEARCH=false
# The paper's agent time limit for non-kernel tasks (GEMINI_TIMEOUT_SEC=12000).
export CLAUDE_EXEC_TIMEOUT_SEC="${CLAUDE_EXEC_TIMEOUT_SEC:-12000}"
export API_TIMEOUT_MS=1200000
export CLAUDE_CODE_MAX_RETRIES=3
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=128000
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=5000
export CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1
# The paper's agents carry nothing between sessions except branch history;
# the CLI's per-directory auto memory would add a side channel.
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONHASHSEED=0

# History visibility: proposals + measured scores only, never earlier code.
export DRSI_HISTORY_SEED_MODE=pruned
# Candidate artifact contract and evaluation.
export DRSI_EVAL_PROGRAM=artifact/program.py
export DRSI_EVAL_TIMEOUT_SEC="${DRSI_EVAL_TIMEOUT_SEC:-3000}"
export VQCC_VERIFY_WORKERS="${VQCC_VERIFY_WORKERS:-8}"
# Task worker: local venv (default) or docker image built by tasks/vqcc_invsqrt/setup.sh.
export VQCC_WORKER_MODE="${VQCC_WORKER_MODE:-local}"
