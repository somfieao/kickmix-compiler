# Copy to .credentials/deepseek.env (ignored), chmod 600, then edit locally.
# No API key is supplied. Use the endpoint/model your own account supports.
#
# DeepSeek official API (Anthropic-compatible endpoint):
export DEEPSEEK_BASE_URL="https://api.deepseek.com/anthropic"
export DEEPSEEK_API_KEY=""
export DEEPSEEK_MODEL="deepseek-flash"            # DeepSeek-V4.1-Flash
#
# Paratera's Anthropic-compatible endpoint (the "1017" snapshot):
# export DEEPSEEK_BASE_URL="https://llmapi.paratera.com"
# export DEEPSEEK_MODEL="DeepSeek-V4.1-Flash-1017"
